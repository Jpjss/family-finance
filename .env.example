# Sincronização (opcional para o modo local)
MONGODB_URI=
# Gere um segredo aleatório de pelo menos 32 caracteres. Não use o mesmo do cron.
AUTH_SECRET=

# Só ative depois de configurar os serviços, publicar e salvar as preferências.
REMINDERS_ENABLED=false
CRON_SECRET=

# E-mail: Resend, com remetente de um domínio verificado
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# WhatsApp: Twilio com remetente habilitado e template aprovado
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
